# Non-secret per-project values for the DEV project tashil-gift-dev (TAG-9).
# firebase-tools loads this file automatically for `--project tashil-gift-dev`.
# Production (tashil-gift) has no env file on purpose: its values are the code
# defaults in functions/env_config.js, so the production deploy is unchanged.
# NEVER put secrets here (API keys, tokens). Secrets go to Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY --project tashil-gift-dev
TASHIL_ENV=dev
PUBLIC_SITE_ORIGIN=https://tashil-gift-dev.web.app
# WhatsApp (WAHA) in dev: keep WAHA_API_KEY in dev's Secret Manager a dummy
# value (WhatsApp then fails closed), or point WAHA_BACKEND_URL at a separate
# test WAHA server. Never use the production WhatsApp session from dev: it
# would message real customers.
# WAHA_BACKEND_URL=https://waha-dev.example.invalid
