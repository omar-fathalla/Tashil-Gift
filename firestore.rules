rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function role() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function isSuperAdmin() {
      return isSignedIn() && !isAnonymous() && role() == 'super_admin';
    }

    function isAdmin() {
      return isSignedIn() && !isAnonymous()
        && (role() == 'super_admin' || role() == 'admin');
    }

    function isPartner() {
      return isSignedIn() && !isAnonymous() && role() == 'partner';
    }

    function partnerSlug() {
      return isPartner() ? request.auth.token.get('companySlug', '') : '';
    }

    function isPartnerOps() {
      return isPartner()
        && partnerSlug().size() > 0
        && request.auth.token.get('partnerAccess', 'read') == 'ops';
    }

    function sameCompany(slug) {
      return isPartner() && partnerSlug().size() > 0 && slug == partnerSlug();
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function eventData(eventId) {
      return get(eventPath(eventId)).data;
    }

    function campaignIsActive(campaignId) {
      return campaignId is string
        && campaignId.size() > 0
        && campaignId.size() <= 128
        && exists(eventPath(campaignId))
        && eventData(campaignId).isActive == true;
    }

    function boundedString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    // Kept small on purpose: Firestore rejects a rule that evaluates more than
    // 1000 expressions, and receipt documents carry many optional OCR fields.
    function validAnonymousReceipt(data) {
      return data.keys().size() <= 80
        && data.keys().size() >= 4
        && boundedString(data.submittedByUid, 128)
        && data.submittedByUid == request.auth.uid
        && data.submittedByUid.size() > 0
        && boundedString(data.campaignId, 128)
        && data.campaignId.size() > 0
        && boundedString(data.companySlug, 128)
        && data.companySlug.size() > 0
        && campaignIsActive(data.campaignId)
        && eventData(data.campaignId).companySlug == data.companySlug
        && data.timestamp == request.time
        && (!(('receipt_number') in data) || boundedString(data.receipt_number, 80))
        && (!(('customerPhone') in data) || boundedString(data.customerPhone, 32))
        && (!(('customerName') in data) || boundedString(data.customerName, 160))
        && (!(('total_value') in data) || (data.total_value is number && data.total_value >= 0 && data.total_value < 1000000000))
        && (!(('extracted_products') in data) || (data.extracted_products is list && data.extracted_products.size() <= 80));
    }

    function partnerReceiptUpdate() {
      return isPartnerOps()
        && sameCompany(resource.data.companySlug)
        && request.resource.data.companySlug == resource.data.companySlug
        && request.resource.data.submittedByUid == resource.data.submittedByUid
        && request.resource.data.campaignId == resource.data.campaignId;
    }

    match /events/{eventId} {
      allow get: if isAdmin()
        || (isAnonymous() && resource.data.isActive == true)
        || sameCompany(resource.data.companySlug);
      // List is allowed only when every candidate document is an active campaign.
      // Clients must query isActive == true (and companySlug for a company link).
      allow list: if isAdmin()
        || (isAnonymous() && resource.data.isActive == true)
        || sameCompany(resource.data.companySlug);
      allow create, update, delete: if isAdmin();

      match /sharded_counters/{counterId} {
        allow read: if isAdmin() || sameCompany(eventData(eventId).companySlug);
        allow write: if isAdmin();

        match /shards/{shardId} {
          allow read: if isAdmin() || sameCompany(eventData(eventId).companySlug);
          allow write: if isAdmin();
        }
      }
    }

    match /receipts_transactions/{txId} {
      allow get: if isAdmin()
        || (isAnonymous() && resource.data.submittedByUid == request.auth.uid)
        || sameCompany(resource.data.companySlug);
      allow list: if isAdmin()
        || (isAnonymous() && resource.data.submittedByUid == request.auth.uid)
        || sameCompany(resource.data.companySlug);
      allow create: if isAdmin()
        || (isAnonymous() && validAnonymousReceipt(request.resource.data))
        || (isPartnerOps()
            && sameCompany(request.resource.data.companySlug)
            && request.resource.data.submittedByUid == request.auth.uid
            && request.resource.data.keys().size() <= 80);
      allow update: if isAdmin() || partnerReceiptUpdate();
      allow delete: if isAdmin();
    }

    match /company_gifts/{giftId} {
      allow read: if isAdmin() || sameCompany(resource.data.companySlug);
      allow write: if isAdmin();
    }

    match /gift_stock_movements/{movementId} {
      allow read: if isAdmin() || sameCompany(resource.data.companySlug);
      allow create, update, delete: if isAdmin();
    }

    match /companies/{companyId} {
      // Portal passwords live on these documents. Partners must not read them.
      allow read, write: if isAdmin();
    }

    match /company_products/{prodId} {
      allow read: if isAdmin()
        || isAnonymous()
        || sameCompany(resource.data.companySlug);
      allow write: if isAdmin();
    }

    match /chain_products_catalog/{catId} {
      allow read, write: if isAdmin();
    }

    match /branches/{branchId} {
      allow read: if isAdmin() || isPartner() || isAnonymous();
      allow write: if isAdmin();
    }

    match /retail_chains/{chainId} {
      allow read: if isAdmin() || isPartner() || isAnonymous();
      allow write: if isAdmin();
    }

    match /ai_brain_directives/{directiveId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /admins/{adminEmail} {
      allow read, write: if isSuperAdmin();
    }

    match /portal_credentials/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /daily_campaign_branch_sales/{docId} {
      allow read: if isAdmin() || sameCompany(resource.data.companySlug);
      allow write: if isAdmin();
    }

    match /campaign_stock_settlements/{docId} {
      allow read: if isAdmin() || sameCompany(resource.data.companySlug);
      allow write: if isAdmin();
    }

    match /marketing_contacts/{contactId} {
      allow read: if isAdmin() || sameCompany(resource.data.companySlug);
      allow create: if isAdmin()
        || (sameCompany(request.resource.data.companySlug)
            && request.resource.data.keys().size() <= 40);
      allow update: if isAdmin()
        || (request.resource.data.keys().size() <= 40
            && sameCompany(resource.data.companySlug)
            && sameCompany(request.resource.data.companySlug));
      allow delete: if isAdmin() || (isPartner() && sameCompany(resource.data.companySlug));
    }

    match /discovered_products_inbox/{inboxId} {
      allow read, write: if isAdmin();
    }

    match /portal_access_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (sameCompany(request.resource.data.companySlug)
            && request.resource.data.keys().size() <= 30);
      allow update, delete: if isAdmin();
    }

    match /shards/{shardId} {
      allow read, write: if isAdmin();
    }

    match /sharded_counters/{counterId} {
      allow read, write: if isAdmin();

      match /shards/{shardId} {
        allow read, write: if isAdmin();
      }
    }

    // WhatsApp webhook state is written only by the Admin SDK.
    // Staff (super_admin and admin) can read the control page. Clients cannot write.
    match /whatsapp_inbound_messages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_message_status/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_outbox/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_sender_links/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_webhook_config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_webhook_campaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // M3: server-only per-client rate limit counters.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
