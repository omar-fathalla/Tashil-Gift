rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidImageUpload() {
      return request.resource != null &&
             request.resource.size < 15 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    match /receipts/{companySlug}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImageUpload();
    }

    match /company_logos/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin() && isValidImageUpload();
    }

    match /company_gifts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin() && isValidImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
