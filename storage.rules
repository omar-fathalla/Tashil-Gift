rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function role() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function isStaff() {
      return isSignedIn()
        && !isAnonymous()
        && (role() == 'super_admin' || role() == 'admin');
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)');
      // SVG is blocked: logos/gifts are publicly readable and SVG can carry script.
    }

    function uploaderMatches() {
      return isSignedIn()
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    function readerIsUploader() {
      return isSignedIn()
        && resource.metadata.uploaderUid == request.auth.uid;
    }

    // Receipt images: any signed-in user (including anonymous field reps) may
    // upload under receipts/, but only staff or the uploader may read them back.
    match /receipts/{companySlug}/{allPaths=**} {
      allow read: if isStaff() || readerIsUploader();
      allow create: if isImageUpload() && uploaderMatches();
      allow update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    // Campaign logos are shown on public links. Writes stay with staff.
    match /company_logos/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    // Gift photos are shown on the claim screen. Writes stay with staff.
    match /company_gifts/{allPaths=**} {
      allow read: if true;
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    // WhatsApp campaign posters and PDFs. Only super_admin and admin may
    // create or delete an object, and only under their own uid. Listing is
    // denied for everyone so the prefix is not enumerable.
    //
    // The app sends WAHA a Firebase download URL (getDownloadURL). That https
    // link carries an unguessable token and can be fetched by the WAHA server
    // without the admin browser session. SDK reads stay staff-only. The token
    // does not expire mid-send the way a short-lived signed URL can.
    function isCampaignMediaUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.metadata.uploaderUid == request.auth.uid
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/(jpeg|png|webp)')
        );
    }

    function isCampaignMediaName(name) {
      return name.matches('.*\\.(pdf|jpe?g|png|webp)')
        && !name.matches('.*\\.\\..*');
    }

    match /whatsapp_campaign_media/{uid}/{fileName} {
      allow get: if isStaff();
      allow list: if false;
      allow create: if isStaff()
        && request.auth.uid == uid
        && isCampaignMediaName(fileName)
        && isCampaignMediaUpload();
      allow update: if false;
      allow delete: if isStaff() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
