{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "bucket": "tashil-gift.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/portal/**",
        "function": "sharePreview"
      },
      {
        "source": "/c/**",
        "function": "sharePreview"
      },
      {
        "source": "/p/**",
        "function": "sharePreview"
      },
      {
        "source": "/ep/**",
        "function": "sharePreview"
      },
      {
        "source": "/event/**",
        "function": "sharePreview"
      },
      {
        "source": "/share/**",
        "function": "sharePreview"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

