{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "bucket": "tashil-gift.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: data: https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://*.google.com https://www.google.com https://www.gstatic.com https://fonts.googleapis.com https://fonts.gstatic.com https://*.firebasestorage.app https://firebasestorage.googleapis.com https://us-central1-tashil-gift.cloudfunctions.net; frame-src 'self' https://www.google.com https://www.gstatic.com https://recaptcha.google.com; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), payment=(), usb=(), interest-cohort=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31556926; includeSubDomains"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      },
      {
        "source": "@(index.html|flutter.js|flutter_bootstrap.js|flutter_service_worker.js|version.json|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "regex": "^/[^/.][^/.]*/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "regex": "^/(?:[^/.][^/]*/){2,}[^/.][^/.]*/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "regex": "^/(?:[^/cpoaes.][^/]*|c[^/l][^/]*|cl|cl[^/i][^/]*|cli|cli[^/e][^/]*|clie|clie[^/n][^/]*|clien|clien[^/t][^/]*|client[^/]+|p[^/or][^/]*|po|po[^/r][^/]*|por|por[^/t][^/]*|port|port[^/a][^/]*|porta|porta[^/l][^/]*|portal[^/]+|pr|pr[^/o][^/]*|pro|pro[^/m][^/]*|prom|prom[^/o][^/]*|promo|promo[^/t][^/]*|promot|promot[^/e][^/]*|promote|promote[^/r][^/]*|promoter[^/]+|o|o[^/p][^/]*|op|op[^/s][^/]*|ops[^/]+|a|a[^/g][^/]*|ag|ag[^/e][^/]*|age|age[^/n][^/]*|agen|agen[^/c][^/]*|agenc|agenc[^/y][^/]*|agency[^/]+|e|e[^/pv][^/]*|ep[^/]+|ev|ev[^/e][^/]*|eve|eve[^/n][^/]*|even|even[^/t][^/]*|event[^/]+|s|s[^/h][^/]*|sh|sh[^/a][^/]*|sha|sha[^/r][^/]*|shar|shar[^/e][^/]*|share[^/]+)/[^/.][^/.]*/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "regex": "^/(?:portal|client|promoter|agency|event|share|ops|ep|p|c)/(?:-[^/.]*|[^/.]*-|[^/.]*--[^/.]*|[^/.]*[^A-Za-z0-9./-][^/.]*)/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "regex": "(?i)\\.(?:php|cgi)/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "canvaskit/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/waha/**",
        "function": "wahaProxy"
      },
      {
        "regex": "^/c/\\d+/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/c/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/portal/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/client/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/promoter/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/ops/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/agency/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/p/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/ep/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/event/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "regex": "^/share/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*/?$",
        "function": {
          "functionId": "sharePreview",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
